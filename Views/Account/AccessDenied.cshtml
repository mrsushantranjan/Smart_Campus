@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-3">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h2 class="fw-bold text-dark mb-2">Access Restricted</h2>
        <p class="text-muted mb-4">
            You do not have the required permissions or role to access this section of the portal.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
            </a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary px-3">
                Check Permissions
            </a>
        </div>
    </div>
</div>

