@model List<Department>
@{
    ViewData["Title"] = "Department Management";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Campus Departments</h2>
        <p class="text-muted small mb-0">Organize faculty assignment, student cohorts, and complaint routings</p>
    </div>
    <div>
        <button type="button" class="btn btn-sm btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createDeptModal">
            <i class="bi bi-plus-lg me-1"></i> Add Department
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="sc-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Department Name</th>
                            <th>Description</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.Any())
                        {
                            @foreach (var dept in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@dept.DepartmentName</div>
                                        <code class="text-muted" style="font-size: 0.72rem;">@dept.Id</code>
                                    </td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(dept.Description) ? "No description provided." : dept.Description)</td>
                                    <td class="text-muted">@dept.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                                onclick="openEditDept('@dept.Id', '@Html.Raw(dept.DepartmentName.Replace("'", "\\'"))', '@Html.Raw((dept.Description ?? "").Replace("'", "\\'"))')">
                                            Edit
                                        </button>
                                        <form asp-action="DeleteDepartment" asp-route-id="@dept.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this department?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No departments created yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Info Column -->
    <div class="col-lg-4">
        <div class="sc-card p-4 bg-light">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle text-primary me-2"></i>Department Routing</h6>
            <p class="small text-muted mb-3">
                Departments serve as the primary routing mechanism for complaints lodged by students. Faculty members assigned to a department can view and progress complaints relevant to their domain.
            </p>
            <div class="small text-muted">
                <strong>Current Active Units:</strong> @Model.Count
            </div>
        </div>
    </div>
</div>

<!-- Modal: Create Department -->
<div class="modal fade" id="createDeptModal" tabindex="-1" aria-labelledby="createDeptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createDeptModalLabel">Add Campus Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Name</label>
                        <input name="DepartmentName" class="form-control" placeholder="e.g. Computer Science & Engineering" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Department overview, responsibilities, or location"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Create Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Department -->
<div class="modal fade" id="editDeptModal" tabindex="-1" aria-labelledby="editDeptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditDepartment" method="post" id="editDeptForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editDeptId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editDeptModalLabel">Edit Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Name</label>
                        <input name="DepartmentName" id="editDeptName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" id="editDeptDesc" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditDept(id, name, desc) {
            document.getElementById('editDeptId').value = id;
            document.getElementById('editDeptName').value = name;
            document.getElementById('editDeptDesc').value = desc;
            new bootstrap.Modal(document.getElementById('editDeptModal')).show();
        }
    </script>
}

