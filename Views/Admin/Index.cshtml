@model AdminDashboardDto
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Admin Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Campus Administration</h2>
        <p class="text-muted small mb-0">System health, KPIs, complaints, library and service operations</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="Reports" class="btn btn-sm btn-outline-primary px-3 shadow-sm">
            <i class="bi bi-bar-chart-line me-1"></i> Full Analytics
        </a>
        <a asp-controller="Announcements" asp-action="Create" class="btn btn-sm btn-primary px-3 shadow-sm">
            <i class="bi bi-megaphone me-1"></i> Broadcast Notice
        </a>
    </div>
</div>

<!-- KPI Grid (Total Users, Complaints, Books, Requests) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="sc-stat-card">
            <div class="stat-info">
                <span class="stat-label">Total Users</span>
                <span class="stat-value">@Model.TotalUsers</span>
                <span class="stat-subtext">@Model.TotalStudents Students &bull; @Model.TotalFaculty Faculty</span>
            </div>
            <div class="stat-icon bg-light text-primary">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="sc-stat-card">
            <div class="stat-info">
                <span class="stat-label">Complaints</span>
                <span class="stat-value">@Model.TotalComplaints</span>
                <span class="stat-subtext text-warning">@Model.PendingComplaints Pending &bull; @Model.ResolvedComplaints Resolved</span>
            </div>
            <div class="stat-icon bg-warning-subtle text-warning">
                <i class="bi bi-shield-exclamation"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="sc-stat-card">
            <div class="stat-info">
                <span class="stat-label">Library Books</span>
                <span class="stat-value">@Model.TotalBooks</span>
                <span class="stat-subtext text-info">@Model.ActiveReservations Active Borrowers</span>
            </div>
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-book-half"></i>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="sc-stat-card">
            <div class="stat-info">
                <span class="stat-label">Service Requests</span>
                <span class="stat-value">@Model.TotalServiceRequests</span>
                <span class="stat-subtext text-muted">Certificates &amp; Campus Services</span>
            </div>
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-file-earmark-check"></i>
            </div>
        </div>
    </div>
</div>

<!-- Admin Quick Action Links Strip -->
<div class="sc-card p-3 mb-4 bg-light">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="small fw-bold text-dark"><i class="bi bi-lightning-charge text-warning me-1"></i>Operations Shortcuts:</span>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Admin" asp-action="Users" class="btn btn-sm btn-white bg-white border">
                <i class="bi bi-people me-1"></i> Manage Users
            </a>
            <a asp-controller="Admin" asp-action="Departments" class="btn btn-sm btn-white bg-white border">
                <i class="bi bi-building me-1"></i> Departments
            </a>
            <a asp-controller="Complaints" asp-action="Index" class="btn btn-sm btn-white bg-white border">
                <i class="bi bi-shield-exclamation me-1"></i> All Complaints
            </a>
            <a asp-controller="Library" asp-action="Index" class="btn btn-sm btn-white bg-white border">
                <i class="bi bi-plus-circle me-1"></i> Add / Edit Books
            </a>
            <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-sm btn-white bg-white border">
                <i class="bi bi-check2-square me-1"></i> Review Requests
            </a>
        </div>
    </div>
</div>

<!-- Tables: Recent Complaints & Recent Service Requests -->
<div class="row g-4">
    <!-- Complaints Table -->
    <div class="col-lg-6">
        <div class="sc-card h-100">
            <div class="sc-card-header">
                <h5 class="sc-card-title"><i class="bi bi-shield-exclamation text-primary me-2"></i>Recent Complaints</h5>
                <a asp-controller="Complaints" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Manage All &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Ticket</th>
                            <th>Student</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.RecentComplaints.Any())
                        {
                            @foreach (var c in Model.RecentComplaints)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;">@c.Title</div>
                                        <span class="text-muted" style="font-size: 0.72rem;">@c.Category &bull; @c.CreatedAt.ToString("MMM dd")</span>
                                    </td>
                                    <td>@(c.UserName ?? "Student")</td>
                                    <td>@Html.Raw(PortalBadgeHelper.RenderBadge(c.Status))</td>
                                    <td class="text-end">
                                        <a asp-controller="Complaints" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">
                                            Manage
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No complaints recorded yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Service Requests Table -->
    <div class="col-lg-6">
        <div class="sc-card h-100">
            <div class="sc-card-header">
                <h5 class="sc-card-title"><i class="bi bi-file-earmark-check text-primary me-2"></i>Recent Service Requests</h5>
                <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Review All &rarr;</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th>Type &amp; Title</th>
                            <th>Requester</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @if (Model.RecentRequests.Any())
                        {
                            @foreach (var r in Model.RecentRequests)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;">@r.Title</div>
                                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@r.RequestType</span>
                                    </td>
                                    <td>@(r.UserName ?? "User")</td>
                                    <td>@Html.Raw(PortalBadgeHelper.RenderBadge(r.Status))</td>
                                    <td class="text-end">
                                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                            Decide
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No pending service requests.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

