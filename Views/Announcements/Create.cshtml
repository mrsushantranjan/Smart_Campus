@model CreateAnnouncementDto
@{
    ViewData["Title"] = "Publish Announcement";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h2 class="fw-bold text-dark mb-1">Create Campus Announcement</h2>
            <p class="text-muted small mb-0">Publish official bulletins and notify registered students and faculty</p>
        </div>

        <div class="sc-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary">Announcement Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Mid-Term Examination Schedule &amp; Room Allocations" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label small fw-semibold text-secondary">Category</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="Academic">Academic Notice</option>
                        <option value="Campus Event">Campus Event</option>
                        <option value="Administrative">Administrative Circular</option>
                        <option value="Holiday">Holiday &amp; Recess</option>
                        <option value="Library">Library Bulletin</option>
                        <option value="Emergency">Urgent Notice</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold text-secondary">Announcement Body</label>
                    <textarea asp-for="Description" class="form-control" rows="6" placeholder="Full announcement text, schedule dates, contact details, or policy changes..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-medium shadow-sm">
                        Broadcast &amp; Notify &rarr;
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

