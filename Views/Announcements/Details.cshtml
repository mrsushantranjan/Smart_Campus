@using System.Security.Claims
@model AnnouncementResponseDto
@{
    ViewData["Title"] = Model.Title;
    var isAdmin = User.IsInRole(UserRoles.Admin);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                &larr; Back to Announcements
            </a>
            @if (isAdmin)
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete announcement?');">
                            <i class="bi bi-trash me-1"></i> Delete
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="sc-card p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                <span class="badge bg-primary-subtle text-primary px-3 py-2 fw-semibold">@Model.Category</span>
                <span class="text-muted small">Published @Model.PublishedAt.ToString("MMMM dd, yyyy HH:mm")</span>
            </div>

            <h2 class="fw-bold text-dark mb-3">@Model.Title</h2>

            <div class="mb-4 text-muted small">
                Posted by: <strong class="text-dark">@Model.PublishedBy</strong> &bull;
                Status: <span class="badge @(Model.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(Model.IsActive ? "Active Notice" : "Draft / Inactive")</span>
            </div>

            <div class="p-3 bg-light rounded-3 text-secondary mb-4" style="white-space: pre-wrap; line-height: 1.8; font-size: 0.95rem;">@Model.Description</div>

            <div class="pt-3 border-top text-muted small d-flex justify-content-between">
                <span>Smart Campus Portal &bull; Official Communication</span>
                <code>Document ID: @Model.Id</code>
            </div>
        </div>
    </div>
</div>

