@using System.Security.Claims
@model List<ComplaintResponseDto>
@{
    ViewData["Title"] = "Campus Complaints";
    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var statusFilter = ViewBag.StatusFilter as string;
    var deptFilter = ViewBag.DepartmentFilter as string;
    var searchFilter = ViewBag.SearchFilter as string;
    var isStudent = User.IsInRole(UserRoles.Student);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            @(isStudent ? "My Complaints" : "Campus Complaint Registry")
        </h2>
        <p class="text-muted small mb-0">Track issues, infrastructure grievances, and departmental resolution progress</p>
    </div>
    @if (isStudent)
    {
        <a asp-action="Create" class="btn btn-sm btn-danger px-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Lodge New Complaint
        </a>
    }
</div>

<!-- Filters Bar -->
<div class="sc-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@searchFilter" class="form-control border-start-0" placeholder="Search by title, category, description..." />
            </div>
        </div>
        <div class="col-sm-3 col-md-3">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                <option value="@ComplaintStatuses.Pending" selected="@(statusFilter == ComplaintStatuses.Pending)">Pending</option>
                <option value="@ComplaintStatuses.Assigned" selected="@(statusFilter == ComplaintStatuses.Assigned)">Assigned</option>
                <option value="@ComplaintStatuses.InProgress" selected="@(statusFilter == ComplaintStatuses.InProgress)">In Progress</option>
                <option value="@ComplaintStatuses.Resolved" selected="@(statusFilter == ComplaintStatuses.Resolved)">Resolved</option>
                <option value="@ComplaintStatuses.Rejected" selected="@(statusFilter == ComplaintStatuses.Rejected)">Rejected</option>
            </select>
        </div>
        <div class="col-sm-3 col-md-3">
            <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All Departments --</option>
                @foreach (var d in departments)
                {
                    <option value="@d.Id" selected="@(deptFilter == d.Id)">@d.DepartmentName</option>
                }
            </select>
        </div>
        <div class="col-sm-2 col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
            @if (!string.IsNullOrEmpty(statusFilter) || !string.IsNullOrEmpty(deptFilter) || !string.IsNullOrEmpty(searchFilter))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
            }
        </div>
    </form>
</div>

<!-- Complaints Table -->
<div class="sc-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th>Title &amp; Category</th>
                    <th>Department</th>
                    @if (!isStudent)
                    {
                        <th>Student</th>
                    }
                    <th>Assigned Staff</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody class="small">
                @if (Model.Any())
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@c.Title</div>
                                <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">@c.Category</span>
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary ms-1" style="font-size: 0.65rem;" title="Has image attachment">
                                        <i class="bi bi-paperclip"></i> Photo
                                    </span>
                                }
                            </td>
                            <td>@(c.DepartmentName ?? "General")</td>
                            @if (!isStudent)
                            {
                                <td>@(c.UserName ?? "Student")</td>
                            }
                            <td>@(string.IsNullOrEmpty(c.AssignedTo) ? "—" : c.AssignedTo)</td>
                            <td>@Html.Raw(PortalBadgeHelper.RenderBadge(c.Status))</td>
                            <td class="text-muted">@c.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary me-1">
                                    Details
                                </a>
                                @if (User.IsInRole(UserRoles.Admin))
                                {
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this complaint record permanently?');">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(isStudent ? 6 : 7)" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                            No complaints found matching criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

