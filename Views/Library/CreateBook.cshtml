@model CreateBookDto
@{
    ViewData["Title"] = "Add Book to Catalog";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h2 class="fw-bold text-dark mb-1">Add Library Book</h2>
            <p class="text-muted small mb-0">Record a new university publication into the MongoDB library collection</p>
        </div>

        <div class="sc-card p-4">
            <form asp-action="CreateBook" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary">Book Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Clean Architecture: A Craftsman's Guide" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Author" class="form-label small fw-semibold text-secondary">Author</label>
                        <input asp-for="Author" class="form-control" placeholder="e.g. Robert C. Martin" required />
                        <span asp-validation-for="Author" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ISBN" class="form-label small fw-semibold text-secondary">ISBN</label>
                        <input asp-for="ISBN" class="form-control" placeholder="e.g. 978-0134494166" required />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Category" class="form-label small fw-semibold text-secondary">Category</label>
                        <select asp-for="Category" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            <option value="Computer Science">Computer Science</option>
                            <option value="Electronics &amp; Electrical">Electronics &amp; Electrical</option>
                            <option value="Mechanical Engineering">Mechanical Engineering</option>
                            <option value="Civil Engineering">Civil Engineering</option>
                            <option value="Mathematics &amp; Physics">Mathematics &amp; Physics</option>
                            <option value="Management &amp; Humanities">Management &amp; Humanities</option>
                            <option value="General Literature">General Literature</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="TotalCopies" class="form-label small fw-semibold text-secondary">Total Inventory Copies</label>
                        <input asp-for="TotalCopies" type="number" min="1" max="1000" class="form-control" required />
                        <span asp-validation-for="TotalCopies" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold text-secondary">Synopsis / Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Brief outline of contents, edition, and syllabus relevance..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-medium shadow-sm">
                        Save to Catalog &rarr;
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

