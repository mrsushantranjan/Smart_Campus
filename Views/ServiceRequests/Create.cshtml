@model CreateServiceRequestDto
@{
    ViewData["Title"] = "New Service Request";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h2 class="fw-bold text-dark mb-1">Submit Service Request</h2>
            <p class="text-muted small mb-0">Apply for campus certificates, ID cards, hostel allocations, or technical assistance</p>
        </div>

        <div class="sc-card p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="RequestType" class="form-label small fw-semibold text-secondary">Request Type</label>
                    <select asp-for="RequestType" class="form-select" required>
                        <option value="@ServiceRequestTypes.IdCard">ID Card Replacement / Re-issue</option>
                        <option value="@ServiceRequestTypes.BonafideCertificate">Bonafide Certificate</option>
                        <option value="@ServiceRequestTypes.Hostel">Hostel Accommodation / Room Change</option>
                        <option value="@ServiceRequestTypes.Transportation">Transportation / Bus Pass</option>
                        <option value="@ServiceRequestTypes.TechnicalSupport">Technical Support / Wi-Fi Access</option>
                        <option value="@ServiceRequestTypes.Other">Other Campus Service</option>
                    </select>
                    <span asp-validation-for="RequestType" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label small fw-semibold text-secondary">Subject / Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Request for Semester 5 Bonafide Certificate" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold text-secondary">Reason / Details</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Specify requirements, purpose (e.g. passport application, bank verification), and any relevant registration numbers..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        &larr; Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-medium shadow-sm">
                        Submit Application &rarr;
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

