@using System.Security.Claims
@model ServiceRequestResponseDto
@{
    ViewData["Title"] = $"Service Request #{Model.Id.Substring(Math.Max(0, Model.Id.Length - 6))}";
    var isAdmin = User.IsInRole(UserRoles.Admin);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-light text-dark border">@Model.RequestType</span>
            <span class="text-muted small">&bull; ID: <code>@Model.Id</code></span>
        </div>
        <h2 class="fw-bold text-dark mb-0">@Model.Title</h2>
    </div>
    <div class="d-flex align-items-center gap-2">
        @Html.Raw(PortalBadgeHelper.RenderBadge(Model.Status))
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            &larr; Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <!-- Request Details -->
        <div class="sc-card mb-4">
            <div class="sc-card-header">
                <h5 class="sc-card-title"><i class="bi bi-file-earmark-text text-primary me-2"></i>Application Details</h5>
                <span class="text-muted small">Submitted @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="sc-card-body">
                <div class="row g-3 mb-3 pb-3 border-bottom">
                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Requester</span>
                        <span class="fw-semibold text-dark">@(Model.UserName ?? "User")</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Category</span>
                        <span class="fw-semibold text-dark">@Model.RequestType</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Current Status</span>
                        <div>@Html.Raw(PortalBadgeHelper.RenderBadge(Model.Status))</div>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small text-uppercase fw-semibold d-block">Last Modified</span>
                        <span class="text-muted">@Model.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Request Justification</span>
                    <div class="p-3 bg-light rounded-3 text-secondary" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                {
                    <div class="p-3 rounded-3 @(Model.Status == ServiceRequestStatuses.Approved ? "bg-success-subtle border border-success-subtle" : "bg-danger-subtle border border-danger-subtle")">
                        <span class="fw-bold small d-block mb-1">
                            <i class="bi bi-shield-check me-1"></i>Official Administrative Remarks:
                        </span>
                        <div class="text-dark small">@Model.AdminRemarks</div>
                    </div>
                }
            </div>
        </div>

        <!-- Admin Decision Card -->
        @if (isAdmin)
        {
            <div class="sc-card">
                <div class="sc-card-header bg-light">
                    <h5 class="sc-card-title"><i class="bi bi-clipboard-check text-primary me-2"></i>Review &amp; Decision</h5>
                </div>
                <div class="sc-card-body">
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Decision Action</label>
                            <select name="Status" class="form-select" required>
                                <option value="@ServiceRequestStatuses.Pending" selected="@(Model.Status == ServiceRequestStatuses.Pending)">Pending Decision</option>
                                <option value="@ServiceRequestStatuses.Approved" selected="@(Model.Status == ServiceRequestStatuses.Approved)">Approve Request</option>
                                <option value="@ServiceRequestStatuses.Rejected" selected="@(Model.Status == ServiceRequestStatuses.Rejected)">Reject Request</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold text-secondary">Administrative Remarks / Instructions</label>
                            <textarea name="AdminRemarks" class="form-control" rows="3" placeholder="Provide reason for approval/rejection or instructions for pickup...">@Model.AdminRemarks</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-medium shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Confirm Decision
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Process Guide -->
    <div class="col-lg-5">
        <div class="sc-card p-4 bg-light">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle text-primary me-2"></i>Processing Guidelines</h6>
            <ul class="small text-muted ps-3 mb-0" style="line-height: 1.8;">
                <li><strong>Bonafide Certificates:</strong> Signed certificates are usually ready for collection at the Registrar's Office within 2 business days after approval.</li>
                <li><strong>ID Cards:</strong> Present proof of lost card report or damaged card at the Security Administration desk for re-issuance.</li>
                <li><strong>Transportation &amp; Hostel:</strong> Allocation decisions are subject to room and route capacity verification.</li>
            </ul>
        </div>
    </div>
</div>

