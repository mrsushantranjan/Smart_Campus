@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var userName = User.Identity?.Name ?? "Student";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName[0].ToString().ToUpper() : "U";

    string defaultDashboardController = "Home";
    if (userRole == UserRoles.Admin) defaultDashboardController = "Admin";
    else if (userRole == UserRoles.Faculty) defaultDashboardController = "Faculty";
    else if (userRole == UserRoles.Student) defaultDashboardController = "Student";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Student Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="dribbble-backdrop">
        <div class="dribbble-canvas">
            <div class="canvas-dots"></div>

            <!-- Left Pill Sidebar -->
            <aside class="dribbble-sidebar">
                <div class="dribbble-sidebar-top">
                    <!-- Brand Emblem -->
                    <a asp-controller="@defaultDashboardController" asp-action="Index" class="dribbble-brand">
                        <img src="~/images/university-crest.svg" alt="University Crest" />
                    </a>

                    <!-- Navigation Links -->
                    <nav class="dribbble-nav">
                        @if (userRole == UserRoles.Admin)
                        {
                            <a class="dribbble-nav-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                <span>Overview</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")"
                               asp-controller="Admin" asp-action="Users">
                                <i class="bi bi-people-fill"></i>
                                <span>Users</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Admin" && currentAction == "Departments" ? "active" : "")"
                               asp-controller="Admin" asp-action="Departments">
                                <i class="bi bi-building"></i>
                                <span>Depts</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Complaints" ? "active" : "")"
                               asp-controller="Complaints" asp-action="Index">
                                <i class="bi bi-calendar-check"></i>
                                <span>Complaints</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Library" ? "active" : "")"
                               asp-controller="Library" asp-action="Index">
                                <i class="bi bi-book"></i>
                                <span>Library</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "ServiceRequests" ? "active" : "")"
                               asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-calendar3"></i>
                                <span>Requests</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Admin" && currentAction == "Reports" ? "active" : "")"
                               asp-controller="Admin" asp-action="Reports">
                                <i class="bi bi-bar-chart-fill"></i>
                                <span>Reports</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                               asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person"></i>
                                <span>Profile</span>
                            </a>
                        }
                        else if (userRole == UserRoles.Faculty)
                        {
                            <a class="dribbble-nav-link @(currentController == "Faculty" ? "active" : "")"
                               asp-controller="Faculty" asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                <span>Overview</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Complaints" ? "active" : "")"
                               asp-controller="Complaints" asp-action="Index">
                                <i class="bi bi-calendar-check"></i>
                                <span>Complaints</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Library" ? "active" : "")"
                               asp-controller="Library" asp-action="Index">
                                <i class="bi bi-book"></i>
                                <span>Classes</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "ServiceRequests" ? "active" : "")"
                               asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-calendar3"></i>
                                <span>Requests</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                               asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person"></i>
                                <span>Profile</span>
                            </a>
                        }
                        else
                        {
                            <!-- Student Default Menu (Matching Dribbble Image Exactly) -->
                            <a class="dribbble-nav-link @(currentController == "Student" || currentController == "Home" ? "active" : "")"
                               asp-controller="@(isAuthenticated ? "Student" : "Home")" asp-action="Index">
                                <i class="bi bi-grid-fill"></i>
                                <span>Overview</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Complaints" ? "active" : "")"
                               asp-controller="Complaints" asp-action="Index">
                                <i class="bi bi-calendar-check"></i>
                                <span>Attendance</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Library" ? "active" : "")"
                               asp-controller="Library" asp-action="Index">
                                <i class="bi bi-pencil-square"></i>
                                <span>Classes</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "ServiceRequests" ? "active" : "")"
                               asp-controller="ServiceRequests" asp-action="Index">
                                <i class="bi bi-calendar3"></i>
                                <span>Calendar</span>
                            </a>
                            <a class="dribbble-nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                               asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person"></i>
                                <span>Profile</span>
                            </a>
                        }
                    </nav>
                </div>

                <!-- Bottom Sign Out Button -->
                <div>
                    @if (isAuthenticated)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" id="dribbbleLogoutForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dribbble-signout-btn">
                                Sign Out
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="dribbble-signout-btn">
                            Sign In
                        </a>
                    }
                </div>
            </aside>

            <!-- Main Right Content Area -->
            <main class="dribbble-main">
                <!-- Top Header -->
                <header class="dribbble-header">
                    <div class="dribbble-welcome-box">
                        <h2 class="dribbble-welcome-title">
                            @if (userRole == UserRoles.Student)
                            {
                                @:Welcome, Student!
                            }
                            else if (userRole == UserRoles.Faculty)
                            {
                                @:Welcome, Professor!
                            }
                            else if (userRole == UserRoles.Admin)
                            {
                                @:Welcome, Admin!
                            }
                            else
                            {
                                @:Welcome to Campus
                            }
                        </h2>
                        <span class="dribbble-active-pill">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.45rem;"></i> Active
                        </span>
                    </div>

                    <div class="dribbble-header-actions">
                        <!-- Search Icon -->
                        <a href="javascript:void(0)" class="dribbble-icon-btn" title="Search">
                            <i class="bi bi-search"></i>
                        </a>

                        <!-- Notification Bell Dropdown -->
                        <div class="dropdown">
                            <a href="#" class="dribbble-icon-btn" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                <i class="bi bi-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge" style="font-size: 0.6rem; padding: 2px 5px;">
                                    0
                                </span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="notifDropdown" style="width: 300px; border-radius: 16px; border: 1px solid #e2e8f0;" id="notifDropdownMenu">
                                <li class="dropdown-header d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark">Notifications</span>
                                    <a asp-controller="Notifications" asp-action="Index" class="small text-decoration-none">View all</a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li class="p-3 text-center text-muted small" id="notifEmptyState">
                                    No new notifications
                                </li>
                                <div id="notifListContainer"></div>
                            </ul>
                        </div>

                        <!-- User Profile Avatar Pill -->
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="~/images/avatar-student.svg" alt="@userName" class="dribbble-user-avatar" />
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuBtn" style="border-radius: 16px;">
                                <li>
                                    <div class="px-3 py-2">
                                        <div class="fw-bold small text-dark">@userName</div>
                                        <div class="text-muted small text-truncate">@userEmail</div>
                                        <span class="badge bg-primary-subtle text-primary mt-1">@userRole</span>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item small" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item small" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger small">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Feedback Alerts -->
                @if (TempData["SuccessMessage"] is string successMsg)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-2 py-2 px-3 small rounded-pill" role="alert">
                        <i class="bi bi-check-circle-fill text-success"></i>
                        <div class="flex-grow-1">@successMsg</div>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMsg)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-2 py-2 px-3 small rounded-pill" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                        <div class="flex-grow-1">@errorMsg</div>
                        <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Body Content -->
                @RenderBody()
            </main>
        </div>

        <!-- Subtle Watermark -->
        <div class="text-center mt-3">
            <span class="dribbble-watermark">dribbble.com</span>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Live notification counter & dropdown powered by REST API
        @if (isAuthenticated)
        {
            <text>
            function escapeHtml(text) {
                if (!text) return '';
                const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
                return text.replace(/[&<>"']/g, m => map[m]);
            }

            async function fetchUnreadNotifications() {
                try {
                    const res = await fetch('/api/notifications/unread-count');
                    if (res.ok) {
                        const count = await res.json();
                        const badge = document.getElementById('notifBadge');
                        if (badge) {
                            if (count > 0) {
                                badge.textContent = count > 99 ? '99+' : count;
                                badge.classList.remove('d-none');
                            } else {
                                badge.classList.add('d-none');
                            }
                        }
                    }
                } catch (e) {}
            }

            async function loadDropdownNotifications() {
                try {
                    const res = await fetch('/api/notifications?unreadOnly=false');
                    if (res.ok) {
                        const items = await res.json();
                        const container = document.getElementById('notifListContainer');
                        const emptyState = document.getElementById('notifEmptyState');
                        if (!container) return;

                        if (items && items.length > 0) {
                            if (emptyState) emptyState.classList.add('d-none');
                            const topItems = items.slice(0, 5);
                            container.innerHTML = topItems.map(n => `
                                <li class="p-2 border-bottom ${!n.isRead ? 'bg-light' : ''}">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div class="small">
                                            <div class="fw-semibold text-dark">${escapeHtml(n.title)}</div>
                                            <div class="text-muted" style="font-size: 0.74rem;">${escapeHtml(n.message)}</div>
                                        </div>
                                        ${!n.isRead ? `<button class="btn btn-sm btn-link p-0 text-primary" onclick="markDropdownRead('${n.id}', event)" title="Mark as read"><i class="bi bi-check2"></i></button>` : ''}
                                    </div>
                                </li>
                            `).join('');
                        } else {
                            if (emptyState) emptyState.classList.remove('d-none');
                            container.innerHTML = '';
                        }
                    }
                } catch (e) {}
            }

            async function markDropdownRead(id, evt) {
                if (evt) evt.stopPropagation();
                try {
                    const res = await fetch('/api/notifications/' + id + '/read', { method: 'PATCH' });
                    if (res.ok) {
                        await fetchUnreadNotifications();
                        await loadDropdownNotifications();
                    }
                } catch (e) {}
            }

            const notifDropdownEl = document.getElementById('notifDropdown');
            if (notifDropdownEl) {
                notifDropdownEl.addEventListener('show.bs.dropdown', loadDropdownNotifications);
            }

            fetchUnreadNotifications();
            setInterval(fetchUnreadNotifications, 30000);
            </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
